---
import Base from '../../layouts/Base.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Проекты" description="Проекты Consult Invest ITIC в Центральной Азии, Китае, странах Залива, Индии и России.">
  <section class="page">
    <div class="wrap">
      <div class="head"><h1 style="font-size:clamp(36px,4.6vw,64px)">Проекты</h1></div>
      <ProjectList projects={projects} />
    </div>
  </section>
</Base>
