RewriteEngine On

# Всегда защищенное соединение. Без этого правила сервер отдавал страницу
# и по http: браузер, набравший адрес без схемы, показывал предупреждение.
# Вторая проверка — для случая, когда сайт стоит за прокси и сам Apache
# видит запрос как незашифрованный.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Адреса без index.html: /index.html -> /, /en/index.html -> /en/
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Кеш: имена файлов со стилями, скриптом и картой содержат хеш,
# поэтому их можно держать в кеше сколько угодно. Страницы — нет.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # Полгода браузер даже не пробует http для этого домена. Снимается
  # удалением строки, но у уже заходивших запомнится до истечения срока.
  Header always set Strict-Transport-Security "max-age=15768000" env=HTTPS
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{8}\.(css|js|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
